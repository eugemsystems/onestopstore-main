NEXT_PUBLIC_API_BASE_URL=http://localhost:5056/v1
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# Internal API URL for server-side rendering (SSR/ISR)
# On cPanel, the Next.js server may not be able to resolve the public domain
# The server.js DNS patch resolves this hostname to the server's IP automatically
NEXT_SERVER_API_BASE_URL=http://localhost:5056/v1

# Server-only key for fetching provider/payment secrets from backend.
# Must match backend `INTERNAL_API_KEY`. Do not prefix with NEXT_PUBLIC_.
NEXT_SERVER_INTERNAL_API_KEY=<generate-with-openssl-rand-hex-32>

NEXT_PUBLIC_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

NEXT_PUBLIC_STRIPE_KEY=pk_test_xxxxxxxxxxxx

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Social Login secrets load from the admin panel through the server-only backend endpoint.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_ID=
NEXT_PUBLIC_GITHUB_ID=

# Facebook Pixel (Optional)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
